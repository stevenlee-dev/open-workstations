{
  "name": "open-workstations",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "vue": "3.5.43",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "^3.6.2",
    "vite": "8.3.0"
  }
}
